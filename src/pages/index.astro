---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>printer.party</title>
  </head>
  <body>
    <main>
      <h1>printer.party</h1>
      <p>Share files and print them, peer-to-peer.</p>

      <nav id="tabs">
        <button class="tab active" data-tab="room">Room</button>
        <button class="tab" data-tab="print">Print</button>
      </nav>

      <div id="tab-room" class="tab-panel active">
        <section id="room-section">
          <div id="room-qr"></div>
          <p>Room: <code id="room-id">connecting...</code></p>
          <p id="room-status"></p>
        </section>

        <section id="peers-section" hidden>
          <h2>Connected Peers</h2>
          <ul id="peers-list"></ul>
        </section>
      </div>

      <div id="tab-print" class="tab-panel">
        <section id="scan-section">
          <h2>Join Room</h2>
          <button id="scan-btn">Scan QR Code</button>
          <div id="scanner" hidden></div>
          <p id="scan-status"></p>
        </section>

        <section id="send-section" hidden>
          <h2>Print File</h2>
          <input type="file" id="file-input" accept=".pdf,image/*" />
          <button id="send-btn" disabled>Print</button>
          <div id="send-progress" hidden>
            <progress id="send-progress-bar" value="0" max="1"></progress>
            <span id="send-progress-text"></span>
          </div>
        </section>
      </div>
    </main>

    <script src="../scripts/printer-party.ts"></script>

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: system-ui, -apple-system, sans-serif;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
        color: #1a1a1a;
      }

      h1 {
        margin-bottom: 0.5rem;
      }

      h2 {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
      }

      section {
        margin-top: 1.5rem;
        padding: 1rem;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
      }

      input[type='text'],
      input[type='file'] {
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        margin-right: 0.5rem;
      }

      button {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 4px;
        background: #4f46e5;
        color: white;
        cursor: pointer;
        margin-right: 0.5rem;
      }

      button:hover {
        background: #4338ca;
      }

      button:disabled {
        background: #9ca3af;
        cursor: not-allowed;
      }

      progress {
        width: 100%;
        height: 1.5rem;
      }

      #room-qr {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
      }

      #peers-list {
        list-style: none;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      #peers-list li {
        background: #e0e7ff;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        font-size: 0.875rem;
        font-family: monospace;
      }

      #scanner {
        margin-top: 1rem;
        border-radius: 8px;
        overflow: hidden;
      }

      #scan-status {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: #6b7280;
      }

      /* Tabs - hidden on desktop */
      #tabs {
        display: none;
      }

      @media (max-width: 640px) {
        #tabs {
          display: flex;
          gap: 0;
          margin-top: 1.5rem;
          border-bottom: 2px solid #e0e0e0;
        }

        .tab {
          flex: 1;
          background: none;
          color: #6b7280;
          border-radius: 8px 8px 0 0;
          padding: 0.75rem 1rem;
          font-size: 1rem;
          margin-right: 0;
          border-bottom: 2px solid transparent;
          margin-bottom: -2px;
        }

        .tab:hover {
          background: #f3f4f6;
          color: #1a1a1a;
        }

        .tab.active {
          color: #4f46e5;
          border-bottom-color: #4f46e5;
          background: none;
        }

        .tab-panel {
          display: none;
        }

        .tab-panel.active {
          display: block;
        }
      }
    </style>
  </body>
</html>
