---
import AppHeader from '../components/AppHeader.astro'
import PrinterPanel from '../components/PrinterPanel.astro'
import PrintingPanel from '../components/PrintingPanel.astro'
import AppFooter from '../components/AppFooter.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>printer.party — easy remote printing</title>
    <meta name="description" content="easy remote printing" />

    <meta property="og:url" content="https://printer.party/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="printer.party" />
    <meta property="og:description" content="easy remote printing" />
    <meta property="og:image" content="https://printer.party/opengraph.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="printer.party" />
    <meta name="twitter:description" content="easy remote printing" />
    <meta name="twitter:image" content="https://printer.party/opengraph.png" />

    <meta name="theme-color" content="#f9f8f6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="printer.party" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <main>
      <AppHeader />

      <nav id="tabs">
        <button class="tab" data-tab="room">Share Printer</button>
        <button class="tab active" data-tab="print">Print File</button>
      </nav>

      <div class="panels">
        <PrinterPanel />
        <PrintingPanel />
      </div>
    </main>

    <AppFooter />

    <script>
      import { actor } from '../scripts/actor'

      // Tab nav: wire clicks + subscribe to keep button active state in sync
      document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
        tab.addEventListener('click', () =>
          actor.send({ type: 'SWITCH_TAB', tab: tab.dataset.tab as 'room' | 'print' })
        )
      })
      actor.subscribe(({ context }) => {
        document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
          tab.classList.toggle('active', tab.dataset.tab === context.activeTab)
        })
      })
    </script>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js')
      }
    </script>

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        --bg: #f9f8f6;
        --card-bg: #ffffff;
        --card-border: #e7e5e4;
        --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.06);
        --card-shadow-hover: 0 2px 8px rgba(0, 0, 0, 0.08);
        --text-primary: #1c1917;
        --text-secondary: #78716c;
        --accent: #292524;
        --accent-hover: #44403c;
        --disabled-bg: #e7e5e4;
        --disabled-text: #a8a29e;
        --cancel: #dc2626;
        --cancel-hover: #b91c1c;

        font-family: system-ui, -apple-system, sans-serif;
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem;
        color: var(--text-primary);
        background: var(--bg);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
      }

      h1 {
        margin-bottom: 0.15rem;
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
      }

      h2 {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
        font-weight: 600;
      }

      /* Inputs */
      input[type='text'],
      input[type='file'] {
        padding: 0.5rem;
        border: 1px solid var(--card-border);
        border-radius: 8px;
        margin-right: 0.5rem;
        background: var(--card-bg);
        color: var(--text-primary);
      }

      input[type='text']:focus {
        outline: 2px solid var(--accent);
        outline-offset: -1px;
      }

      input[type='file']::file-selector-button {
        padding: 0.4rem 0.8rem;
        border: 1px solid var(--card-border);
        border-radius: 6px;
        background: var(--bg);
        color: var(--text-primary);
        cursor: pointer;
        margin-right: 0.5rem;
        font-family: inherit;
      }

      /* Buttons */
      button {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 8px;
        background: var(--accent);
        color: white;
        cursor: pointer;
        margin-right: 0.5rem;
        font-weight: 500;
        font-size: 0.95rem;
        transition: background 0.15s ease;
      }

      button:hover {
        background: var(--accent-hover);
      }

      button:disabled {
        background: var(--disabled-bg);
        color: var(--disabled-text);
        cursor: not-allowed;
      }

      /* Progress bar */
      progress {
        width: 100%;
        height: 0.5rem;
        border-radius: 4px;
        border: none;
        overflow: hidden;
        background: var(--disabled-bg);
      }

      progress::-webkit-progress-bar {
        background: var(--disabled-bg);
        border-radius: 4px;
      }

      progress::-webkit-progress-value {
        background: var(--accent);
        border-radius: 4px;
      }

      progress::-moz-progress-bar {
        background: var(--accent);
        border-radius: 4px;
      }

      section {
        margin-top: 1.5rem;
        padding: 1.5rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
      }

      /* Desktop two-column layout */
      .panels {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      /* Tabs — hidden on desktop */
      #tabs {
        display: none;
      }

      @media (max-width: 640px) {
        body {
          padding: 1.5rem;
        }

        .panels {
          grid-template-columns: 1fr;
        }

        #tabs {
          display: flex;
          gap: 0;
          margin-top: 1.5rem;
          border-bottom: 1px solid var(--card-border);
        }

        .tab {
          flex: 1;
          background: none;
          color: var(--text-secondary);
          border-radius: 0;
          padding: 0.75rem 1rem;
          font-size: 0.95rem;
          margin-right: 0;
          border-bottom: 2px solid transparent;
          margin-bottom: -1px;
          box-shadow: none;
        }

        .tab:hover {
          background: none;
          color: var(--text-primary);
        }

        .tab.active {
          color: var(--text-primary);
          border-bottom-color: var(--text-primary);
          background: none;
        }

        .tab-panel {
          display: none;
        }

        .tab-panel.active {
          display: block;
        }
      }
    </style>
  </body>
</html>
