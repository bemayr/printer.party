---
import AppHeader from '../components/AppHeader.astro'
import AppFooter from '../components/AppFooter.astro'
import TabNav from '../components/TabNav'
import PrinterPanel from '../components/PrinterPanel'
import PrintingPanel from '../components/PrintingPanel'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>printer.party — easy remote printing</title>
    <meta name="description" content="easy remote printing" />

    <meta property="og:url" content="https://printer.party/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="printer.party" />
    <meta property="og:description" content="easy remote printing" />
    <meta property="og:image" content="https://printer.party/opengraph.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="printer.party" />
    <meta name="twitter:description" content="easy remote printing" />
    <meta name="twitter:image" content="https://printer.party/opengraph.png" />

    <meta name="theme-color" content="#f9f8f6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="printer.party" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <main>
      <AppHeader />

      <TabNav client:only="preact" />

      <div class="panels">
        <PrinterPanel client:only="preact" />
        <PrintingPanel client:only="preact" />
      </div>
    </main>

    <AppFooter />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js')
      }
    </script>

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        --bg: #f9f8f6;
        --card-bg: #ffffff;
        --card-border: #e7e5e4;
        --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.06);
        --card-shadow-hover: 0 2px 8px rgba(0, 0, 0, 0.08);
        --text-primary: #1c1917;
        --text-secondary: #78716c;
        --accent: #292524;
        --accent-hover: #44403c;
        --disabled-bg: #e7e5e4;
        --disabled-text: #a8a29e;
        --cancel: #dc2626;
        --cancel-hover: #b91c1c;

        font-family: system-ui, -apple-system, sans-serif;
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem;
        color: var(--text-primary);
        background: var(--bg);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
      }

      h1 {
        margin-bottom: 0.15rem;
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
      }

      h2 {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
        font-weight: 600;
      }

      /* Inputs */
      input[type='text'],
      input[type='file'] {
        padding: 0.5rem;
        border: 1px solid var(--card-border);
        border-radius: 8px;
        margin-right: 0.5rem;
        background: var(--card-bg);
        color: var(--text-primary);
      }

      input[type='text']:focus {
        outline: 2px solid var(--accent);
        outline-offset: -1px;
      }

      input[type='file']::file-selector-button {
        padding: 0.4rem 0.8rem;
        border: 1px solid var(--card-border);
        border-radius: 6px;
        background: var(--bg);
        color: var(--text-primary);
        cursor: pointer;
        margin-right: 0.5rem;
        font-family: inherit;
      }

      /* Buttons */
      button {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 8px;
        background: var(--accent);
        color: white;
        cursor: pointer;
        margin-right: 0.5rem;
        font-weight: 500;
        font-size: 0.95rem;
        transition: background 0.15s ease;
      }

      button:hover {
        background: var(--accent-hover);
      }

      button:disabled {
        background: var(--disabled-bg);
        color: var(--disabled-text);
        cursor: not-allowed;
      }

      /* Progress bar */
      progress {
        width: 100%;
        height: 0.5rem;
        border-radius: 4px;
        border: none;
        overflow: hidden;
        background: var(--disabled-bg);
      }

      progress::-webkit-progress-bar {
        background: var(--disabled-bg);
        border-radius: 4px;
      }

      progress::-webkit-progress-value {
        background: var(--accent);
        border-radius: 4px;
      }

      progress::-moz-progress-bar {
        background: var(--accent);
        border-radius: 4px;
      }

      section {
        margin-top: 1.5rem;
        padding: 1.5rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
      }

      /* Desktop two-column layout */
      .panels {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      /* Tabs — hidden on desktop */
      #tabs {
        display: none;
      }

      @media (max-width: 640px) {
        body {
          padding: 1.5rem;
        }

        .panels {
          grid-template-columns: 1fr;
        }

        #tabs {
          display: flex;
          gap: 0;
          margin-top: 1.5rem;
          border-bottom: 1px solid var(--card-border);
        }

        .tab {
          flex: 1;
          background: none;
          color: var(--text-secondary);
          border-radius: 0;
          padding: 0.75rem 1rem;
          font-size: 0.95rem;
          margin-right: 0;
          border-bottom: 2px solid transparent;
          margin-bottom: -1px;
          box-shadow: none;
        }

        .tab:hover {
          background: none;
          color: var(--text-primary);
        }

        .tab.active {
          color: var(--text-primary);
          border-bottom-color: var(--text-primary);
          background: none;
        }

        .tab-panel {
          display: none;
        }

        .tab-panel.active {
          display: block;
        }
      }

      /* ── PrinterPanel styles ─────────────────────────────────────────────────── */

      #room-qr {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
        padding: 1rem;
        background: white;
        border-radius: 12px;
        border: 1px solid var(--card-border);
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
      }

      .room-id-display {
        text-align: center;
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: 0.3em;
        text-transform: lowercase;
        font-family: system-ui, -apple-system, sans-serif;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
      }

      .room-hint {
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
      }

      .peer-status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin: 1.25rem auto 0;
      }

      .peer-status::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--disabled-bg);
      }

      .peer-status.connected::before {
        background: #22c55e;
      }

      .peer-count {
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      .peer-status.connected .peer-count {
        color: var(--text-primary);
      }

      .panel-title {
        margin: -1.5rem -1.5rem 1.25rem;
        padding: 1rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--card-border);
      }

      @media (max-width: 640px) {
        .panel-title {
          display: none;
        }
      }

      /* ── PrintingPanel styles ────────────────────────────────────────────────── */

      .step-label {
        margin-top: 0;
        margin-bottom: 0.75rem;
        font-size: 0.85rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
      }

      /* Connect status */
      .connect-status {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
      }

      .connect-status-dot {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-primary);
      }

      .connect-status-dot::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
      }

      /* Join methods */
      .join-methods {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }

      .join-scan,
      .join-code {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }

      .muted-btn {
        background: none;
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 400;
        padding: 0.25rem 0.5rem;
        margin: 0;
      }

      .muted-btn:hover {
        background: none;
        color: var(--text-primary);
      }

      .join-room-id {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      #room-id-input {
        width: 8rem;
        text-align: center;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: lowercase;
      }

      /* Scanner */
      #scanner {
        margin-top: 1rem;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--card-border);
      }

      #scan-status {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      /* Send section */
      .send-section {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--card-border);
      }

      .send-section button:not(.cancel-btn) {
        display: block;
        margin: 0 auto;
      }

      #send-progress {
        margin-top: 1rem;
      }

      #send-progress-text {
        color: var(--text-secondary);
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: inline-block;
      }

      .progress-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .progress-row progress {
        flex: 1;
      }

      .cancel-btn {
        background: var(--cancel);
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
      }

      .cancel-btn:hover {
        background: var(--cancel-hover);
      }
    </style>
  </body>
</html>
