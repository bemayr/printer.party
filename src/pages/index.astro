<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>printer.party — easy remote printing</title>
    <meta name="description" content="easy remote printing" />

    <meta property="og:url" content="https://printer.party/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="printer.party" />
    <meta property="og:description" content="easy remote printing" />
    <meta property="og:image" content="https://printer.party/opengraph.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="printer.party" />
    <meta name="twitter:description" content="easy remote printing" />
    <meta name="twitter:image" content="https://printer.party/opengraph.png" />

    <meta name="theme-color" content="#f9f8f6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="printer.party" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <main>
      <header class="app-header">
        <img src="/icon.png" alt="printer.party" class="app-icon" width="64" height="64" />
        <div>
          <h1>printer.party</h1>
          <p class="subtitle">easy remote printing</p>
        </div>
        <button id="info-btn" class="info-btn" aria-label="How it works">?</button>
      </header>

      <div id="info-overlay" class="info-overlay" hidden>
        <div class="info-card">
          <h2>How it works</h2>
          <ol>
            <li><strong>Open printer.party</strong> on the computer connected to your printer &mdash; it creates a code and QR code.</li>
            <li><strong>On your phone</strong>, open printer.party and enter the code or scan the QR code to connect.</li>
            <li><strong>Pick a file</strong> (PDF or image) on your phone and tap Print &mdash; it gets sent directly to the other device and opens the print dialog.</li>
          </ol>
          <p>Files are transferred peer-to-peer. Nothing is uploaded to a server.</p>
        </div>
      </div>

      <nav id="tabs">
        <button class="tab active" data-tab="room">Share Printer</button>
        <button class="tab" data-tab="print">Print File</button>
      </nav>

      <div class="panels">
        <div id="tab-room" class="tab-panel active">
          <section id="room-section">
            <h2 class="panel-title">Share Printer</h2>
            <p class="room-hint">Scan the QR code or enter the code on another device to connect.</p>
            <div id="room-qr"></div>
            <p class="room-id-display" id="room-id">connecting...</p>
            <span id="peer-status" class="peer-status waiting"><span id="peer-count" class="peer-count">Waiting for connection...</span></span>
          </section>
        </div>

        <div id="tab-print" class="tab-panel">
          <section id="scan-section">
            <h2 class="panel-title">Print File</h2>
            <h2 class="step-label">1. Connect</h2>
            <div id="connect-form" class="join-methods">
              <div id="join-scan" class="join-scan">
                <button id="scan-btn">Scan QR Code</button>
                <button id="show-code-btn" class="muted-btn">Enter code instead</button>
              </div>
              <div id="join-code" class="join-code" hidden>
                <div class="join-room-id">
                  <input type="text" id="room-id-input" placeholder="code" maxlength="4" autocapitalize="none" autocomplete="off" />
                  <button id="join-btn">Join</button>
                </div>
                <button id="show-scan-btn" class="muted-btn">Scan QR instead</button>
              </div>
            </div>
            <div id="connect-status" class="connect-status" hidden>
              <span id="connect-status-dot" class="connect-status-dot"></span>
              <span id="connect-status-text">Connected</span>
              <button id="disconnect-btn" class="muted-btn">Connect to different printer</button>
            </div>
            <div id="scanner" hidden></div>
            <p id="scan-status"></p>

            <div id="send-section" class="send-section" hidden>
              <h2 class="step-label">2. Print</h2>
              <input type="file" id="file-input" accept=".pdf,image/*" hidden />
              <button id="send-btn">Choose File & Print</button>
              <div id="send-progress" hidden>
                <div class="progress-row">
                  <progress id="send-progress-bar" value="0" max="1"></progress>
                  <button id="cancel-btn" class="cancel-btn">Cancel</button>
                </div>
                <span id="send-progress-text"></span>
              </div>
            </div>
          </section>
        </div>
      </div>
    </main>

    <script src="../scripts/printer-party.ts"></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js')
      }
    </script>

    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        --bg: #f9f8f6;
        --card-bg: #ffffff;
        --card-border: #e7e5e4;
        --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.06);
        --card-shadow-hover: 0 2px 8px rgba(0, 0, 0, 0.08);
        --text-primary: #1c1917;
        --text-secondary: #78716c;
        --accent: #292524;
        --accent-hover: #44403c;
        --disabled-bg: #e7e5e4;
        --disabled-text: #a8a29e;
        --cancel: #dc2626;
        --cancel-hover: #b91c1c;

        font-family: system-ui, -apple-system, sans-serif;
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem;
        color: var(--text-primary);
        background: var(--bg);
        min-height: 100vh;
      }

      .app-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.5rem;
      }

      .info-btn {
        margin-left: auto;
        margin-right: 0;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border-radius: 50%;
        font-size: 0.9rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--card-bg);
        color: var(--text-secondary);
        border: 1px solid var(--card-border);
        box-shadow: none;
      }

      .info-btn:hover {
        background: var(--card-bg);
        color: var(--text-primary);
        box-shadow: none;
        transform: none;
      }

      .info-overlay {
        z-index: 10;
        margin-top: 1rem;
      }

      .info-overlay[hidden] {
        display: none;
      }

      .info-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--card-shadow);
      }

      .info-card h2 {
        margin-top: 0;
        margin-bottom: 1rem;
      }

      .info-card ol {
        padding-left: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1rem;
      }

      .info-card p {
        color: var(--text-secondary);
        font-size: 0.9rem;
      }

      .app-icon {
        border-radius: 14px;
        box-shadow: var(--card-shadow);
        flex-shrink: 0;
      }

      h1 {
        margin-bottom: 0.15rem;
        font-size: 2rem;
        font-weight: 700;
        color: var(--text-primary);
      }

      .subtitle {
        color: var(--text-secondary);
        font-size: 0.95rem;
      }

      h2 {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        color: var(--text-primary);
        font-weight: 600;
      }

      section {
        margin-top: 1.5rem;
        padding: 1.5rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 12px;
        box-shadow: var(--card-shadow);
      }

      /* Inputs */
      input[type="text"],
      input[type="file"] {
        padding: 0.5rem;
        border: 1px solid var(--card-border);
        border-radius: 8px;
        margin-right: 0.5rem;
        background: var(--card-bg);
        color: var(--text-primary);
      }

      input[type="text"]:focus {
        outline: 2px solid var(--accent);
        outline-offset: -1px;
      }

      input[type="file"]::file-selector-button {
        padding: 0.4rem 0.8rem;
        border: 1px solid var(--card-border);
        border-radius: 6px;
        background: var(--bg);
        color: var(--text-primary);
        cursor: pointer;
        margin-right: 0.5rem;
        font-family: inherit;
      }

      /* Buttons */
      button {
        padding: 0.6rem 1.2rem;
        border: none;
        border-radius: 8px;
        background: var(--accent);
        color: white;
        cursor: pointer;
        margin-right: 0.5rem;
        font-weight: 500;
        font-size: 0.95rem;
        transition: background 0.15s ease;
      }

      button:hover {
        background: var(--accent-hover);
      }

      button:disabled {
        background: var(--disabled-bg);
        color: var(--disabled-text);
        cursor: not-allowed;
      }

      /* Progress bar */
      progress {
        width: 100%;
        height: 0.5rem;
        border-radius: 4px;
        border: none;
        overflow: hidden;
        background: var(--disabled-bg);
      }

      progress::-webkit-progress-bar {
        background: var(--disabled-bg);
        border-radius: 4px;
      }

      progress::-webkit-progress-value {
        background: var(--accent);
        border-radius: 4px;
      }

      progress::-moz-progress-bar {
        background: var(--accent);
        border-radius: 4px;
      }

      #send-progress {
        margin-top: 1rem;
      }

      #send-progress-text {
        color: var(--text-secondary);
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: inline-block;
      }

      /* QR code */
      #room-qr {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
        padding: 1rem;
        background: white;
        border-radius: 12px;
        border: 1px solid var(--card-border);
        width: fit-content;
        margin-left: auto;
        margin-right: auto;
      }

      /* Room ID display */
      .room-id-display {
        text-align: center;
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: 0.3em;
        text-transform: lowercase;
        font-family: system-ui, -apple-system, sans-serif;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
      }

      .room-hint {
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
      }

      /* Peer status indicator */
      .peer-status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin: 1.25rem auto 0;
      }

      .peer-status::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--disabled-bg);
      }

      .peer-status.connected::before {
        background: #22c55e;
      }

      .peer-count {
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      .peer-status.connected .peer-count {
        color: var(--text-primary);
      }

      /* Connect status (replaces form when connected) */
      .connect-status {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
      }

      .connect-status[hidden] {
        display: none;
      }

      .connect-status-dot {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-primary);
      }

      .connect-status-dot::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
      }

      /* Join methods */
      .join-methods {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }

      .join-scan,
      .join-code {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
      }

      .join-scan[hidden],
      .join-code[hidden] {
        display: none;
      }

      .muted-btn {
        background: none;
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 400;
        padding: 0.25rem 0.5rem;
        margin: 0;
      }

      .muted-btn:hover {
        background: none;
        color: var(--text-primary);
      }

      .join-room-id {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      #room-id-input {
        width: 8rem;
        text-align: center;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: lowercase;
      }

      .join-or {
        color: var(--text-secondary);
        font-size: 0.875rem;
      }

      /* Progress row */
      .progress-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .progress-row progress {
        flex: 1;
      }

      .cancel-btn {
        background: var(--cancel);
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
      }

      .cancel-btn:hover {
        background: var(--cancel-hover);
      }

      /* Panel titles (desktop only) */
      .panel-title {
        margin: -1.5rem -1.5rem 1.25rem;
        padding: 1rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--card-border);
      }

      /* Step labels */
      .step-label {
        margin-top: 0;
        margin-bottom: 0.75rem;
        font-size: 0.85rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary);
      }

      /* Send section (inside scan card) */
      .send-section {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--card-border);
      }

      .send-section #send-btn {
        display: block;
        margin: 0 auto;
      }

      /* Scanner */
      #scanner {
        margin-top: 1rem;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--card-border);
      }

      #scan-status {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      /* Desktop two-column layout */
      .panels {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      /* Tabs - hidden on desktop */
      #tabs {
        display: none;
      }

      @media (max-width: 640px) {
        body {
          padding: 1.5rem;
        }

        .panels {
          grid-template-columns: 1fr;
        }

        #tabs {
          display: flex;
          gap: 0;
          margin-top: 1.5rem;
          border-bottom: 1px solid var(--card-border);
        }

        .tab {
          flex: 1;
          background: none;
          color: var(--text-secondary);
          border-radius: 0;
          padding: 0.75rem 1rem;
          font-size: 0.95rem;
          margin-right: 0;
          border-bottom: 2px solid transparent;
          margin-bottom: -1px;
          box-shadow: none;
        }

        .tab:hover {
          background: none;
          color: var(--text-primary);
        }

        .tab.active {
          color: var(--text-primary);
          border-bottom-color: var(--text-primary);
          background: none;
        }

        .panel-title {
          display: none;
        }

        .tab-panel {
          display: none;
        }

        .tab-panel.active {
          display: block;
        }
      }
    </style>
  </body>
</html>
