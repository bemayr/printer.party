---
---

<div id="tab-room" class="tab-panel">
  <section id="room-section">
    <h2 class="panel-title">Share Printer</h2>
    <p class="room-hint">Scan the QR code or enter the code on another device to connect.</p>
    <div id="room-qr"></div>
    <p class="room-id-display" id="room-id">connecting...</p>
    <span id="peer-status" class="peer-status waiting">
      <span id="peer-count" class="peer-count">Waiting for connection...</span>
    </span>
  </section>
</div>

<script>
  import { actor } from '../scripts/actor'
  import QRCodeStyling from 'qr-code-styling'

  const roomQrEl = document.getElementById('room-qr') as HTMLDivElement
  const roomIdEl = document.getElementById('room-id') as HTMLElement
  const peerStatus = document.getElementById('peer-status') as HTMLElement
  const peerCount = document.getElementById('peer-count') as HTMLElement
  const tabPanel = document.getElementById('tab-room') as HTMLDivElement

  let qrCode: QRCodeStyling | null = null
  let lastRoomId = ''

  actor.subscribe((snapshot) => {
    const { context } = snapshot
    const isConnected = snapshot.matches({ active: 'connected' })

    // Tab visibility
    tabPanel.classList.toggle('active', context.activeTab === 'room')

    // Peer status
    peerStatus.classList.toggle('connected', isConnected)
    peerCount.textContent = isConnected
      ? context.peers.size === 1
        ? '1 peer connected'
        : `${context.peers.size} peers connected`
      : 'Waiting for connection...'

    // QR code — only re-render when roomId changes
    if (context.roomId !== lastRoomId) {
      lastRoomId = context.roomId
      roomIdEl.textContent = context.roomId
      const roomUrl = `${window.location.origin}${window.location.pathname}#${context.roomId}`
      if (qrCode) {
        qrCode.update({ data: roomUrl })
      } else {
        qrCode = new QRCodeStyling({
          width: 200,
          height: 200,
          data: roomUrl,
          dotsOptions: { type: 'rounded', color: '#292524' },
          backgroundOptions: { color: 'transparent' },
        })
        qrCode.append(roomQrEl)
      }
    }
  })
</script>

<style>
  #room-qr {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
    padding: 1rem;
    background: white;
    border-radius: 12px;
    border: 1px solid var(--card-border);
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  .room-id-display {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: lowercase;
    font-family: system-ui, -apple-system, sans-serif;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .room-hint {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .peer-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.25rem auto 0;
  }

  .peer-status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--disabled-bg);
  }

  .peer-status.connected::before {
    background: #22c55e;
  }

  .peer-count {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .peer-status.connected .peer-count {
    color: var(--text-primary);
  }

  .panel-title {
    margin: -1.5rem -1.5rem 1.25rem;
    padding: 1rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--card-border);
  }

  @media (max-width: 640px) {
    .panel-title {
      display: none;
    }
  }
</style>
